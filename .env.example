# ==============================================================================
# JAGA LAHAN — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Salin berkas ini menjadi `.env.local` untuk pengembangan lokal atau tambahkan
# variabel berikut pada pengaturan Environment Variables di proyek Vercel Anda.
# Jika dikosongkan, aplikasi tetap berjalan penuh dalam Mode Demo Luring (Offline-First).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

